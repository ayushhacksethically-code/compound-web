# 🌐 compound-web (English Production Interface)
import_karo web

keep app_server = newServer(8080)

task create_web_server(p) do
    app_server = newServer(p)
    show "🌐 Web server initialized on port:", p
done

task listen_route(m, path, handler) do
    app_server.addRoute(m, path, handler)
    show "📍 Registered Route [" + m + "]:", path
done

task send_text(req, body) do
    asyncCheck req.sendText(body)
done

task send_json(req, json_body) do
    asyncCheck req.sendJson(json_body)
done

task start_web_server() do
    app_server.start()
done
