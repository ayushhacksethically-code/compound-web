# 🌐 compound-web (Hinglish Production Interface)
import_karo web

rakho app_server = newServer(8080)

kaam web_server_banao(p) toh
    app_server = newServer(p)
    dikhao "🌐 Web server initialize ho gaya port par:", p
khatam

kaam route_suno(m, path, handler) toh
    app_server.addRoute(m, path, handler)
    dikhao "📍 Registered Route [" + m + "]:", path
khatam

kaam send_text(req, body) toh
    asyncCheck req.sendText(body)
khatam

kaam send_json(req, json_body) toh
    asyncCheck req.sendJson(json_body)
khatam

kaam web_server_start() toh
    app_server.start()
khatam
